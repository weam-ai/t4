# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production build
/build
/dist

# misc
.DS_Store
*.pem

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# editor/IDE settings
.vscode/
.idea/
*.swp

# lock files (if you want to ignore them)
/package-lock.json
/yarn.lock
/pnpm-lock.yaml

# others
*.tgz
*.tar.gz
